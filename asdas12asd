-- Auto-rejoin: when Roblox throws a disconnect/kick error (Error 279, the "garden took
-- too long to load" kick, lost connection, etc.) jump straight back into a fresh server.
-- GuiService.ErrorMessageChanged fires the moment that error prompt appears; we retry the
-- teleport a few times because the client may still have a heartbeat for a second or two.
-- Best-effort — if the client tears down instantly, your executor's built-in Auto-Rejoin
-- is the backstop (it lives outside the game's Lua and survives a hard kick).
do
    local rejoinPlaceId = game.PlaceId
    local rejoinBusy = false
    game:GetService("GuiService").ErrorMessageChanged:Connect(function()
        if not st.autoRejoin or rejoinBusy then return end
        rejoinBusy = true
        notify("Disconnected — rejoining...")
        for _ = 1, 6 do
            pcall(function() TeleportService:Teleport(rejoinPlaceId, LocalPlayer) end)
            task.wait(1.5)
        end
        rejoinBusy = false
    end)
end

-- Anti-fling (no noclip). The old build flipped every character part to
-- CanCollide=false each frame too -- that is what made the character float frozen
-- and read as "not loaded", and GaG2's anti-cheat trips on the collision tampering.
-- We drop noclip entirely and only cancel velocity, since movement is CFrame-driven.
RunService.Stepped:Connect(function()
    if not st.antiFling then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    -- Cancel any velocity before physics runs: kills knockback/fling from other
    -- players and physics glitches. Collision stays ON, so the character loads,
    -- stands on the ground / FPS floor, and renders normally. Movement is
    -- CFrame-driven, so zeroing velocity never blocks our own motion.
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end)

